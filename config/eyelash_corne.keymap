#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150   // 10

// 图层索引常量，方便在行为和输入处理器里引用

#define L_BASE          0
#define L_MEDIA         1
#define L_NAV           2
#define L_MOUSE         3
#define L_SYM           4
#define L_NUM           5
#define L_FUN           6
#define L_MOUSE_SLOW    7   // layer_11
#define L_MOUSE_NORMAL  8   // layer_12
#define L_MOUSE_FAST    9   // layer_13
#define L_MOUSE_TURBO   10  // layer_14

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// 鼠标移动速度缩放：基础速度 + 按图层覆盖，不同图层对应不同速度档位

&mmv_input_listener {
    // 默认“普通”速度

    input-processors = <&zip_xy_scaler 2 1>;

    slow {
        layers = <L_MOUSE_SLOW>;

        // 慢速：缩小移动量

        input-processors = <&zip_xy_scaler 1 4>;
    };

    normal {
        layers = <L_MOUSE_NORMAL>;

        // 普通：维持默认缩放

        input-processors = <&zip_xy_scaler 2 1>;
    };

    fast {
        layers = <L_MOUSE_FAST>;

        // 快：放大移动量

        input-processors = <&zip_xy_scaler 4 1>;
    };

    turbo {
        layers = <L_MOUSE_TURBO>;

        // 飞快：大幅放大移动量

        input-processors = <&zip_xy_scaler 8 1>;
    };
};

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
            layers = <0 1 2 3 4 5 6 7>;
        };

        togame {
            bindings = <&to 8>;
            key-positions = <20 3>;
            layers = <0 1 2 3 4 5 6 7 8>;
        };

        toqwer {
            bindings = <&to 1>;
            key-positions = <20 2>;
            layers = <0 1 2 3 4 5 6 7 8>;
        };

        toarst {
            bindings = <&to 0>;
            key-positions = <20 1>;
            layers = <0 1 2 3 4 5 6 7 8>;
        };

        f1 {
            bindings = <&kp F1>;
            key-positions = <1 14>;
        };

        f2 {
            bindings = <&kp F2>;
            key-positions = <2 15>;
        };

        f3 {
            bindings = <&kp F3>;
            key-positions = <3 16>;
        };

        f4 {
            bindings = <&kp F4>;
            key-positions = <4 17>;
        };

        f5 {
            bindings = <&kp F5>;
            key-positions = <5 18>;
        };

        f6 {
            bindings = <&kp F6>;
            key-positions = <7 22>;
        };

        f7 {
            bindings = <&kp F7>;
            key-positions = <8 23>;
        };

        f8 {
            bindings = <&kp F8>;
            key-positions = <9 24>;
        };

        f9 {
            bindings = <&kp F9>;
            key-positions = <25 10>;
        };

        f10 {
            bindings = <&kp F10>;
            key-positions = <11 26>;
        };

        f11 {
            bindings = <&kp F11>;
            key-positions = <10 39>;
        };

        f12 {
            bindings = <&kp F12>;
            key-positions = <11 40>;
        };

        lkuohao {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <2 3>;
        };

        rkuohao {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <3 4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        arst {
            bindings = <
&kp ESCAPE  &kp Q           &kp W           &kp F           &kp P             &kp B                                   &mmv MOVE_UP                     &kp J        &kp L              &kp U         &kp Y            &kp SQT          &trans
&kp LSHFT   &hm LEFT_GUI A  &hm LEFT_ALT R  &hm LCTRL S     &hm LEFT_SHIFT T  &kp G                   &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp M        &hm RIGHT_SHIFT N  &hm RCTRL E   &hm RIGHT_ALT I  &hm RIGHT_GUI O  &trans
&kp LCTRL   &kp Z           &kp X           &kp C           &kp D             &kp V      &mkp RCLK                    &mmv MOVE_DOWN                   &kp K        &kp H              &kp COMMA     &kp PERIOD       &kp SLASH        &trans
                                            &lt 2 LEFT_ALT  &lt 3 SPACE       &lt 4 TAB                                                                &lt 5 ENTER  &lt 6 BACKSPACE    &lt 7 DELETE
            >;

            label = "arst";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOLUME_DOWN>;
        };

        qwer {
            bindings = <
&trans  &kp Q           &kp W           &kp E         &kp R             &kp T                                   &mmv MOVE_UP                     &kp Y        &kp U              &kp I         &kp O            &kp P               &trans
&trans  &hm LEFT_GUI A  &hm LEFT_ALT S  &hm LCTRL D   &hm LEFT_SHIFT F  &kp G                   &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp H        &hm RIGHT_SHIFT J  &hm RCTRL K   &hm RIGHT_ALT L  &hm SEMI SEMICOLON  &trans
&trans  &kp Z           &kp X           &kp C         &kp V             &kp B      &mkp RCLK                    &mmv MOVE_DOWN                   &kp N        &kp M              &kp COMMA     &kp DOT          &kp FSLH            &trans
                                        &lt 2 ESCAPE  &lt 3 SPACE       &lt 4 TAB                                                                &lt 5 ENTER  &lt 6 BACKSPACE    &lt 7 DELETE
            >;

            label = "qwer";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOLUME_DOWN>;
        };

        media {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans          &trans      &kp LA(LEFT)      &kp LC(W)  &kp LC(LS(T))  &kp LA(RIGHT)  &trans
&trans  &trans        &trans        &trans        &trans        &bt BT_CLR              &trans  &trans  &trans  &trans      &kp LC(LS(TAB))   &kp LC(W)  &kp LC(T)      &kp LC(TAB)    &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans            &trans          &trans      &kp LC(H)         &kp LC(E)  &kp LC(F5)     &kp LC(D)      &trans
                                    &trans        &trans        &trans                                          &kp C_STOP  &kp K_PLAY_PAUSE  &trans
            >;

            label = "media";
        };

        nav {
            bindings = <
&trans  &kp LC(Q)  &kp LC(W)  &kp LC(F)  &kp LC(P)  &kp LC(Y)                            &msc SCRL_UP                     &kp K_REDO  &kp C_AC_PASTE  &kp C_AC_COPY  &kp C_AC_CUT  &kp K_UNDO  &trans
&trans  &kp LC(A)  &kp LC(R)  &kp LC(S)  &kp LC(T)  &kp LC(G)            &msc SCRL_LEFT  &trans          &msc SCRL_RIGHT  &kp CAPS    &kp LEFT        &kp DOWN       &kp UP        &kp RIGHT   &trans
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(D)  &kp LC(V)  &trans                    &msc SCRL_DOWN                   &kp INSERT  &kp HOME        &kp PAGE_DOWN  &kp PAGE_UP   &kp END     &trans
                              &trans     &trans     &trans                                                                &trans      &kp BACKSPACE   &kp DEL
            >;

            label = "nav";
            sensor-bindings = <&inc_dec_kp PLUS MINUS>;
        };

        mouse {
            bindings = <
&trans  &trans          &trans        &trans          &trans           &trans                    &trans          &trans     &kp K_PASTE     &kp K_COPY      &kp K_CUT     &trans           &trans
&trans  &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans            &trans  &trans  &trans  &trans     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans          &trans        &mkp RCLK       &mkp LCLK        &trans  &trans            &trans          &trans     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                                      &trans          &trans           &trans                                    &mkp RCLK  &mkp LCLK       &mkp MCLK
            >;

            label = "mouse";
        };

        sym {
            bindings = <
&trans  &kp LEFT_BRACE  &kp AMPERSAND    &kp ASTERISK          &kp LEFT_PARENTHESIS   &kp RIGHT_BRACE                    &trans          &kp EXCLAMATION  &kp LEFT_PARENTHESIS  &trans  &kp RIGHT_PARENTHESIS  &kp COLON      &trans
&trans  &kp COLON       &kp DOLLAR       &kp PERCENT           &kp CARET              &kp PLUS                   &trans  &trans  &trans  &kp QUESTION     &kp LEFT_BRACKET      &trans  &kp RIGHT_BRACKET      &kp SEMICOLON  &trans
&trans  &kp TILDE       &kp EXCLAMATION  &kp AT_SIGN           &kp HASH               &kp PIPE         &trans            &trans          &trans           &kp LBRC              &trans  &kp RIGHT_BRACE        &trans         &trans
                                         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE                                     &trans           &trans                &trans
            >;

            label = "sym";
        };

        num {
            bindings = <
&trans  &kp LEFT_BRACKET  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp RIGHT_BRACKET                       &trans          &kp LEFT_BRACKET  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp RIGHT_BRACKET  &trans
&trans  &kp SEMICOLON     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL                       &trans  &trans  &trans  &kp PLUS          &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_0       &trans
&trans  &kp TILDE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NON_US_BACKSLASH  &trans            &trans          &kp X             &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ASTERISK       &trans
                                        &kp PERIOD    &kp NUMBER_0  &kp MINUS                                               &trans            &trans        &trans
            >;

            label = "num";
        };

        fun {
            bindings = <
&trans  &kp F12  &kp F7  &kp F8  &kp F9  &trans                    &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F11  &kp F4  &kp F5  &kp F6  &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &trans  &trans            &trans          &trans  &trans  &trans  &trans  &trans  &trans
                         &trans  &trans  &trans                                    &trans  &trans  &trans
            >;

            label = "fun";
        };

        game {
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E      &kp R         &kp T                         &trans          &trans     &trans          &kp UP_ARROW    &trans           &kp ESCAPE  &trans
&kp LEFT_SHIFT  &kp A  &kp S  &kp D      &kp F         &kp G                 &trans  &trans  &trans  &trans     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp ENTER   &trans
&kp LCTRL       &kp Z  &kp X  &kp C      &kp NUMBER_3  &kp H       &kp F1            &trans          &trans     &trans          &trans          &trans           &trans      &trans
                              &kp SPACE  &kp SPACE     &kp ESCAPE                                    &kp ENTER  &kp SPACE       &kp SPACE
            >;

            label = "game";
        };
    };
};
